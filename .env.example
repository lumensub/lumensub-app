# Which Stellar network to use: testnet, mainnet or futurenet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC endpoint. Leave empty on testnet to use the SDF endpoint.
# Mainnet has no public default, so you must set this there.
NEXT_PUBLIC_SOROBAN_RPC_URL=

# Address of the deployed subscription contract (starts with C).
NEXT_PUBLIC_SUBSCRIPTION_CONTRACT_ID=

# Base URL of lumensub-backend, without a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8080
